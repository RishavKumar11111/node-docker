{
  "name": "node-docker",
  "version": "1.0.0",
  "description": "Minimal production-ready Node.js + TypeScript + Docker boilerplate using Express and pnpm",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "docker",
    "pnpm",
    "boilerplate",
    "backend"
  ],
  "author": "Rishav Kumar",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
